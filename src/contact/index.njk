<section class="main-contact-form-container">
  


    <form class="main-contact-form js-form-reveal" 
  name="contact"
  method="POST"
  data-netlify="true"
  data-netlify-honeypot="bot-field"
  action="/contact/success/" netlify
>
  <!-- Required hidden input for Netlify -->
  <input type="hidden" name="form-name" value="contact" />

  <!-- Honeypot (hidden from humans) -->
  <p style="display:none;">
    <label>
      Don’t fill this out if you’re human: <input name="bot-field" />
    </label>
  </p>

  <div class="js-form-field">
    <label for="fullName">Full Name *</label><br>
    <input id="fullName" name="fullName" type="text" autocomplete="name" required />
  </div>

  <div class="js-form-field">
    <label for="businessName">Business Name</label><br>
    <input id="businessName" name="businessName" type="text" autocomplete="organization" />
  </div>

  <div class="js-form-field">
    <label for="serviceArea">Town / Service Area</label><br>
    <input id="serviceArea" name="serviceArea" type="text" placeholder="Example: Shelton, CT" />
  </div>

  <div class="js-form-field">
    <label for="email">Email Address *</label><br>
    <input id="email" name="email" type="email" autocomplete="email" required />
  </div>

  <div class="js-form-field">
    <label for="phone">Phone Number</label><br>
    <input id="phone" name="phone" type="tel" autocomplete="tel" />
  </div>

  <div class="js-form-field">
    <label for="website">Website URL</label><br>
    <input id="website" name="website" type="url" placeholder="https://example.com" />
  </div>

  <div class="js-form-field">
    <label for="help">What can I help you with? *</label><br>
    <select id="help" name="help" required>
      <option value="" selected disabled>Select one</option>
      <option>New Website</option>
      <option>Website Redesign</option>
      <option>Website Updates / Fixes</option>
      <option>SEO / Get Found on Google & Generate Leads</option>
      <option>Speed / Mobile Improvements</option>
      <option>Other</option>
    </select>
  </div>

  <div class="js-form-field">
    <label for="contactMethod">Preferred Contact Method</label><br>
    <select id="contactMethod" name="contactMethod">
      <option>Text</option>
      <option>Phone</option>
      <option>Email</option>
    </select>
  </div>

  <div class="js-form-field">
    <label for="message">Your Message *</label><br>
    <textarea
      id="message"
      name="message"
      rows="7"
      required
      placeholder="Tell me what you do, what you want the website to accomplish, and any links you want me to see."
    ></textarea>
  </div>
  <div class="js-form-field">
    <button class="cta1" type="submit">Send Message</button>
  </div>
</form>
</div>


</section>

