      <label for="fullName">Full Name *</label><br>

      <input
        id="fullName"
        name="fullName"
        type="text"
        autocomplete="name"
        required
      />
    </div>

    <div class="js-form-field">
      <label for="businessName">Business Name</label><br>

      <input
        id="businessName"
        name="businessName"
        type="text"
        autocomplete="organization"
      />
    </div>

    <div class="js-form-field">
      <label for="email">Email Address *</label><br>

      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
      />
    </div>

    <div class="js-form-field">
      <label for="phone">Phone Number</label><br>

      <input
        id="phone"
        name="phone"
        type="tel"
        autocomplete="tel"
      />
    </div>

    <div class="js-form-field">
      <label for="website">Current Website URL</label><br>

      <input
        id="website"
        name="website"
        type="url"
        placeholder="https://example.com"
      />
    </div>

    <div class="js-form-field">
      <label for="help">What do you need help with? *</label><br>

      <select id="help" name="help" required>

        <option value="" selected disabled>
          Select one
        </option>

        <option value="Free Website Review">
          Free Website Review
        </option>

        <option value="Website Tune-Up">
          Website Tune-Up — $100
        </option>

        <option value="Fix Existing Website">
          Fix or Update My Existing Website
        </option>

        <option value="New Website">
          Build a New Website
        </option>

        <option value="SEO">
          Improve My Google Visibility
        </option>

        <option value="Monthly Support">
          Monthly Website and SEO Help
        </option>

        <option value="Graphics or Illustration">
          Custom Graphics or Illustration
        </option>

        <option value="Animation or Creative Feature">
          Animation or Creative Website Feature
        </option>

        <option value="Flyer or Promotional Design">
          Flyer or Promotional Design
        </option>

        <option value="Other Idea">
          I Have Another Idea
        </option>

        <option value="Not Sure">
          I’m Not Sure What I Need
        </option>

      </select>
    </div>

    <div class="js-form-field">
      <label for="message">Tell Me About Your Project *</label><br>

      <textarea
        id="message"
        name="message"
        rows="6"
        required
        placeholder="Tell me about your business, your website, and what you would like help with."
      ></textarea>
    </div>

    <div class="js-form-field">
      <button class="cta1" type="submit">
        Send Message
      </button>
