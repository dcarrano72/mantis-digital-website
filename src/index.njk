<section id="contact" class="main-contact-form-container" style="margin-top: 20px; padding-top: 0;">
  <form class="main-contact-form js-form-reveal"
    name="contact"
    method="POST"
    data-netlify="true"
    data-netlify-honeypot="bot-field"
    action="/contact/success/"
    netlify
  >
    <input type="hidden" name="form-name" value="contact" />

    <p style="display:none;">
      <label>
        Don’t fill this out if you’re human: <input name="bot-field" />
      </label>
    </p>

    <div class="js-form-field">
      <label for="fullName">Full Name *</label><br>
      <input id="fullName" name="fullName" type="text" autocomplete="name" required />
    </div>

    <div class="js-form-field">
      <label for="businessName">Business Name</label><br>
      <input id="businessName" name="businessName" type="text" autocomplete="organization" />
    </div>

    <div class="js-form-field">
      <label for="email">Email Address *</label><br>
      <input id="email" name="email" type="email" autocomplete="email" required />
    </div>

    <div class="js-form-field">
      <label for="phone">Phone Number</label><br>
      <input id="phone" name="phone" type="tel" autocomplete="tel" />
    </div>

    <div class="js-form-field">
      <label for="website">Website URL</label><br>
      <input id="website" name="website" type="url" placeholder="https://example.com" />
    </div>

    <div class="js-form-field">
      <label for="help">What are you interested in? *</label><br>
      <select id="help" name="help" required>
        <option value="" selected disabled>Select one</option>
        <option>$500 Starter Website</option>
        <option>Starter Plan — $250/month</option>
        <option>Growth Plan — $500/month</option>
        <option>Advanced Plan — $700+/month</option>
        <option>Something Else / Other</option>
      </select>
    </div>

    <div class="js-form-field">
      <label for="message">Your Message *</label><br>
      <textarea
        id="message"
        name="message"
        rows="6"
        required
        placeholder="Tell me what your business does and what you want help with."
      ></textarea>
    </div>

    <div class="js-form-field">
      <button class="cta1" type="submit">Send Message</button>
    </div>
  </form>
</section>


